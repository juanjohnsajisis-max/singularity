{
  "name": "singularity",
  "version": "0.1.0",
  "private": true,
  "description": "LNP Forge — design lipid nanoparticles in your browser. Next.js + Lenis + Electron.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "verify:export": "node tools/check-export.mjs",
    "start": "next start",
    "postinstall": "node tools/install-electron.mjs --optional",
    "electron:install": "node tools/install-electron.mjs",
    "electron:doctor": "node tools/install-electron.mjs --check",
    "preelectron:dev": "node tools/install-electron.mjs",
    "electron:dev": "next build && electron .",
    "preelectron:start": "node tools/install-electron.mjs",
    "electron:start": "electron .",
    "prebundle": "node tools/install-electron.mjs",
    "bundle": "next build && electron-builder --win",
    "prebundle:dir": "node tools/install-electron.mjs",
    "bundle:dir": "next build && electron-builder --win dir"
  },
  "dependencies": {
    "lenis": "^1.1.18",
    "next": "15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
